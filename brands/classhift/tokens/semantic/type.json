{
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": "{family.sans}"
    },
    "body": {
      "$value": "{family.sans}"
    },
    "meta": {
      "$value": "{family.mono}"
    }
  },
  "text-size": {
    "$type": "dimension",
    "hero": {
      "$value": "{size.hero}"
    },
    "headline": {
      "$value": "{size.headline}"
    },
    "title": {
      "$value": "{size.title}"
    },
    "quote": {
      "$value": "{size.quote}"
    },
    "lead": {
      "$value": "{size.lead}"
    },
    "body": {
      "$value": "{size.body}"
    },
    "small": {
      "$value": "{size.small}"
    },
    "meta": {
      "$value": "{size.meta}"
    },
    "micro": {
      "$value": "{size.micro}"
    }
  },
  "leading": {
    "$type": "number",
    "hero": {
      "$value": 1.04,
      "$description": "Hangul display floor. Below ~1.02 the jamo stack collides — this was an observed defect, not a preference."
    },
    "headline": {
      "$value": 1.06
    },
    "title": {
      "$value": 1.26
    },
    "quote": {
      "$value": 1.34
    },
    "lead": {
      "$value": 1.7
    },
    "body": {
      "$value": 1.85,
      "$description": "Hangul body floor"
    },
    "meta": {
      "$value": 1.75
    }
  },
  "tracking": {
    "$type": "dimension",
    "hero": {
      "$value": "-0.045em"
    },
    "headline": {
      "$value": "-0.045em"
    },
    "title": {
      "$value": "-0.035em"
    },
    "quote": {
      "$value": "-0.035em"
    },
    "body": {
      "$value": "0em"
    },
    "meta": {
      "$value": "0.14em",
      "$description": "mono register runs open and uppercase"
    },
    "eyebrow": {
      "$value": "0.18em"
    }
  },
  "measure": {
    "$type": "dimension",
    "prose": {
      "$value": "62ch",
      "$description": "reading column cap"
    },
    "hero": {
      "$value": "22ch"
    },
    "standfirst": {
      "$value": "40ch",
      "$description": "the hero standfirst — narrower than prose so it reads as a caption to the headline, not as body copy"
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "display": {
      "$value": "{weight.bold}"
    },
    "strong": {
      "$value": "{weight.semibold}"
    },
    "body": {
      "$value": "{weight.regular}"
    },
    "lead": {
      "$value": "{weight.medium}"
    }
  }
}