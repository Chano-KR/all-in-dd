# This repo is the reusable skeleton. Real brands are private work —
# they live here on disk but are never tracked. `example` is the template.
brands/*
!brands/example/
brands/example/dist/

# S1 audition boards are run evidence, not skeleton.
auditions/

# Renders, screenshots, and generated proofs stay out — except README assets.
**/_shots/
**/_img/
**/.impeccable/
*.png
*.pdf
!assets/readme/*.png
skills-lock*
