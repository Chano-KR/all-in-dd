{
  "blank": {
    "$description": "The signature device. A rule that is drawn, filled, and redrawn. It is the same object in the hero (the output word), in the chain (the slots), and on paper (the line you write on), which is why it is one component and not three.",
    "rule-empty": { "$type": "color", "$value": "{line.rule-empty}" },
    "rule-filled": { "$type": "color", "$value": "{line.rule}" },
    "text-placeholder": { "$type": "color", "$value": "{text.tertiary}", "$description": "shows the kind of thing that goes in: a number reads n, a thing reads by its noun" },
    "text-written": { "$type": "color", "$value": "{text.written}" },
    "weight-written": { "$type": "fontWeight", "$value": "{font-weight.written}" },
    "bg-filled": { "$type": "color", "$value": "{surface.filled}" },
    "pad-x": { "$type": "dimension", "$value": "{space.2}" },
    "draw": { "$type": "duration", "$value": "{motion.duration.rule}" }
  },

  "sentence": {
    "$description": "A prompt, set as the thing you read rather than the thing you look at.",
    "font": { "$type": "fontFamily", "$value": "{font.display}" },
    "size": { "$type": "dimension", "$value": "{web.text-size.sentence}" },
    "leading": { "$type": "number", "$value": "{web.leading.sentence}" },
    "weight": { "$type": "fontWeight", "$value": "{font-weight.sentence}" },
    "tracking": { "$type": "dimension", "$value": "{web.tracking.display}" },
    "measure": { "$type": "dimension", "$value": "{web.measure.claim}" },
    "dim": { "$type": "number", "$value": 0.16, "$description": "a word not yet reached by the reader's scroll" }
  },

  "result": {
    "$description": "What came back. A different stock from the page, told apart by material and never by an accent stripe.",
    "bg": { "$type": "color", "$value": "{surface.inverse}" },
    "text": { "$type": "color", "$value": "{text.on-inverse}" },
    "figure": { "$type": "color", "$value": "{text.on-inverse-signal}" },
    "edge": { "$type": "color", "$value": "{line.rule}", "$description": "a 2px pen rule along the top edge — the same stroke as a blank, because the output is what the blank produced" },
    "pad-x": { "$type": "dimension", "$value": "{space.6}" },
    "pad-y": { "$type": "dimension", "$value": "{space.5}" },
    "measure": { "$type": "dimension", "$value": "{web.measure.prose}" }
  },

  "kind-swatch": {
    "$description": "The hero's cycling output. One ink per document type, drawn from kind.* so a colour here always names a kind.",
    "exam": { "$type": "color", "$value": "{kind.exam}" },
    "drill": { "$type": "color", "$value": "{kind.drill}" },
    "analysis": { "$type": "color", "$value": "{kind.analysis}" },
    "mock": { "$type": "color", "$value": "{kind.mock}" },
    "roll": { "$type": "duration", "$value": "{motion.duration.roll}" },
    "dwell": { "$type": "duration", "$value": "{motion.duration.dwell}" }
  },

  "row": {
    "$description": "A volume in the lineup. Hairlines and space, not a card — cards are the lazy answer and a four-up card grid is the shape the gate exists to catch.",
    "bg": { "$type": "color", "$value": "{surface.page}" },
    "bg-hover": { "$type": "color", "$value": "{state.hover-surface}" },
    "bg-press": { "$type": "color", "$value": "{state.press-surface}" },
    "bg-peak": { "$type": "color", "$value": "{surface.filled}", "$description": "the volume with the most prompts, on pen-washed ground" },
    "line": { "$type": "color", "$value": "{line.hair}" },
    "underline": { "$type": "color", "$value": "{line.rule}", "$description": "on hover the row draws its own blank" },
    "pad-y": { "$type": "dimension", "$value": "{space.5}" },
    "gap": { "$type": "dimension", "$value": "{gap.inline-md}" }
  },

  "control": {
    "$description": "Every state is declared. A control with no hover and no focus shipped once already.",
    "primary-bg": { "$type": "color", "$value": "{surface.inverse}" },
    "primary-text": { "$type": "color", "$value": "{text.on-inverse}" },
    "primary-bg-hover": { "$type": "color", "$value": "{state.hover-ink}" },
    "primary-bg-press": { "$type": "color", "$value": "{state.press-ink}" },
    "secondary-line": { "$type": "color", "$value": "{line.hair}" },
    "secondary-line-hover": { "$type": "color", "$value": "{line.edge}" },
    "secondary-text": { "$type": "color", "$value": "{text.primary}" },
    "corner": { "$type": "dimension", "$value": "{corner.control}" },
    "pad-x": { "$type": "dimension", "$value": "{space.6}" },
    "pad-y": { "$type": "dimension", "$value": "{space.4}" },
    "lift": { "$type": "dimension", "$value": "{space.1}", "$description": "hover travel. There is no shadow to grow, because the brand has no blur." },
    "speed": { "$type": "duration", "$value": "{motion.duration.state}" }
  },

  "focus-ring": {
    "color": { "$type": "color", "$value": "{state.focus-ring}" },
    "width": { "$type": "dimension", "$value": "{ring.width}" },
    "offset": { "$type": "dimension", "$value": "{ring.offset}" }
  },

  "meta": {
    "font": { "$type": "fontFamily", "$value": "{font.notation}" },
    "size": { "$type": "dimension", "$value": "{web.text-size.meta}" },
    "leading": { "$type": "number", "$value": "{web.leading.meta}" },
    "tracking": { "$type": "dimension", "$value": "{web.tracking.meta}" },
    "text": { "$type": "color", "$value": "{text.tertiary}" }
  },

  "page-print": {
    "$description": "The interior. Its claim is that the page is a place to write, so the writable room is a token and not a layout accident.",
    "font": { "$type": "fontFamily", "$value": "{font.read}" },
    "size": { "$type": "dimension", "$value": "{print.text-size.body}" },
    "leading": { "$type": "number", "$value": "{print.leading.read}" },
    "measure": { "$type": "dimension", "$value": "{print.measure.prose}" },
    "rule": { "$type": "color", "$value": "{line.rule-empty}" },
    "write-height": { "$type": "dimension", "$value": "{print.rule-rhythm.write-height}" },
    "pitch": { "$type": "dimension", "$value": "{print.rule-rhythm.pitch}" }
  }
}
