{
  "button": {
    "primary": {
      "bg": {
        "$type": "color",
        "$value": "{accent.action}"
      },
      "text": {
        "$type": "color",
        "$value": "{text.on-accent}"
      },
      "padding-y": {
        "$type": "dimension",
        "$value": "{space.5}"
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{space.8}"
      },
      "size": {
        "$type": "dimension",
        "$value": "{size.meta}"
      },
      "tracking": {
        "$type": "dimension",
        "$value": "{tracking.meta}"
      }
    },
    "secondary": {
      "border": {
        "$type": "color",
        "$value": "{line.rule}"
      },
      "text": {
        "$type": "color",
        "$value": "{text.primary}"
      }
    },
    "on-inverse": {
      "border": {
        "$type": "color",
        "$value": "{green.200}"
      },
      "text": {
        "$type": "color",
        "$value": "{text.on-inverse}"
      }
    }
  },
  "field": {
    "bg": {
      "$type": "color",
      "$value": "{surface.raised}"
    },
    "border": {
      "$type": "color",
      "$value": "{line.rule}"
    },
    "text": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "padding-y": {
      "$type": "dimension",
      "$value": "{space.4}"
    },
    "padding-x": {
      "$type": "dimension",
      "$value": "{space.4}"
    }
  },
  "table": {
    "header-text": {
      "$type": "color",
      "$value": "{text.muted}"
    },
    "row-line": {
      "$type": "color",
      "$value": "{line.hair}"
    },
    "frame": {
      "$type": "color",
      "$value": "{line.rule}"
    },
    "caption-bg": {
      "$type": "color",
      "$value": "{surface.inverse}"
    },
    "caption-text": {
      "$type": "color",
      "$value": "{text.on-inverse}"
    }
  },
  "code": {
    "bg": {
      "$type": "color",
      "$value": "{surface.sunken}"
    },
    "text": {
      "$type": "color",
      "$value": "{text.primary}"
    }
  },
  "mark": {
    "stroke": {
      "$type": "color",
      "$value": "{accent.mark}"
    },
    "stroke-width": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "hand-drawn underline, relative to hero size"
    },
    "highlight-bg": {
      "$type": "color",
      "$value": "{accent.highlight}"
    }
  }
}